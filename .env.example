# Copier en .env.local sur la machine de démo.
# mock = aucun appel IA, textes déterministes (Vercel, CI, démo sans login)
# cli  = Claude Code local via `claude -p` (machine de démo, abonnement)
LLM_BACKEND=mock
# LLM_BACKEND=cli

# Alias de modèle accepté par Claude Code (surcharger si besoin)
# LLM_MODEL=sonnet
# low | medium | high (défaut : low)
# LLM_EFFORT=low

# Journal local des prompts + réponses dans .llm-debug/prompts.jsonl
# Contient les réponses d'entretien : local uniquement.
# LLM_DEBUG_PROMPTS=1

# Optionnel : chemin absolu vers le binaire si l'auto-détection échoue.
# CLAUDE_BIN=/Users/toi/.local/bin/claude
